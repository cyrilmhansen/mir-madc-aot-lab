+
+static void basic_data_reserve (void) {
+  if (basic_data_len < basic_data_cap) return;
+  size_t cap = basic_data_cap ? basic_data_cap * 2 : 16;
+  if (cap < basic_data_cap || cap > SIZE_MAX / sizeof (*basic_data_items)) basic_data_oom ();
+  BasicData *items = realloc (basic_data_items, cap * sizeof (*basic_data_items));
+  if (items == NULL) basic_data_oom ();
+  basic_data_items = items;
+  basic_data_cap = cap;
+}
+
