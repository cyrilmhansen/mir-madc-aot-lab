--- a/basic/src/basic_runtime.c
+++ b/basic/src/basic_runtime.c
@@ -605,6 +605,49 @@
 BasicData *basic_data_items = NULL;
 size_t basic_data_len = 0;
 size_t basic_data_pos = 0;
+static size_t basic_data_cap = 0;
+
+void basic_data_fini (void) {
+  for (size_t i = 0; i < basic_data_len; i++)
+    if (basic_data_items[i].is_str) free (basic_data_items[i].str);
+  free (basic_data_items);
+  basic_data_items = NULL;
+  basic_data_len = basic_data_cap = basic_data_pos = 0;
+}
+
+void basic_data_init (void) { basic_data_fini (); }
+
+static void basic_data_oom (void) {
+  fputs ("BASIC: unable to allocate DATA table\n", stderr);
+  basic_data_fini ();
+  exit (EXIT_FAILURE);
+}
+
+static void basic_data_reserve (void) {
+  if (basic_data_len < basic_data_cap) return;
+  size_t cap = basic_data_cap ? basic_data_cap * 2 : 16;
+  if (cap < basic_data_cap || cap > SIZE_MAX / sizeof (*basic_data_items)) basic_data_oom ();
+  BasicData *items = realloc (basic_data_items, cap * sizeof (*basic_data_items));
+  if (items == NULL) basic_data_oom ();
+  basic_data_items = items;
+  basic_data_cap = cap;
+}
+
+void basic_data_add_num (basic_num_t value) {
+  basic_data_reserve ();
+  basic_data_items[basic_data_len++] = (BasicData) {.is_str = 0, .num = value, .str = NULL};
+}
+
+void basic_data_add_str (const char *value) {
+  if (value == NULL) value = "";
+  size_t len = strlen (value);
+  if (len == SIZE_MAX) basic_data_oom ();
+  basic_data_reserve ();
+  char *copy = malloc (len + 1);
+  if (copy == NULL) basic_data_oom ();
+  memcpy (copy, value, len + 1);
+  basic_data_items[basic_data_len++] = (BasicData) {.is_str = 1, .num = BASIC_ZERO, .str = copy};
+}
 
