+  basic_data_reserve ();
+  basic_data_items[basic_data_len++] = (BasicData) {.is_str = 0, .num = value, .str = NULL};
+}
+
+void basic_data_add_str (const char *value) {
+  if (value == NULL) value = "";
+  size_t len = strlen (value);
+  if (len == SIZE_MAX) basic_data_oom ();
+  basic_data_reserve ();
+  char *copy = malloc (len + 1);
+  if (copy == NULL) basic_data_oom ();
+  memcpy (copy, value, len + 1);
+  basic_data_items[basic_data_len++] = (BasicData) {.is_str = 1, .num = BASIC_ZERO, .str = copy};
