main:	func	i64
	local	i64:ret_stack, i64:ret_sp, d:$t0, d:A, i64:$t1, i64:B$, d:$t2, d:C
	local	i64:$t3, i64:D$, d:$t4, d:E, i64:$t5, i64:$t6, i64:$t7, i64:$t8

# 0 args, 16 locals, 0 globals
	alloca	ret_stack, 1024
	mov	ret_sp, 0
	call	basic_data_init_p, basic_data_init
	call	basic_data_add_num_p, basic_data_add_num, 5.00000000000000000000000000000000000000000000000000000e+00
	call	basic_data_add_str_p, basic_data_add_str, "again\000"
	call	basic_data_add_num_p, basic_data_add_num, 8.00000000000000000000000000000000000000000000000000000e+00
	mov	D$, 0
	mov	B$, 0
	call	basic_enable_line_tracking_p, basic_enable_line_tracking, 1.00000000000000000000000000000000000000000000000000000e+00
L1:
	call	basic_set_line_p, basic_set_line, 1.00000000000000000000000000000000000000000000000000000e+01
L2:
	call	basic_set_line_p, basic_set_line, 2.00000000000000000000000000000000000000000000000000000e+01
	call	basic_read_p, basic_read, $t0
	dmov	A, $t0
	call	basic_read_str_p, basic_read_str, $t1
	mov	B$, $t1
L3:
	call	basic_set_line_p, basic_set_line, 3.00000000000000000000000000000000000000000000000000000e+01
	call	basic_restore_p, basic_restore
L4:
	call	basic_set_line_p, basic_set_line, 4.00000000000000000000000000000000000000000000000000000e+01
	call	basic_read_p, basic_read, $t2
	dmov	C, $t2
	call	basic_read_str_p, basic_read_str, $t3
	mov	D$, $t3
	call	basic_read_p, basic_read, $t4
	dmov	E, $t4
L5:
	call	basic_set_line_p, basic_set_line, 5.00000000000000000000000000000000000000000000000000000e+01
	call	basic_print_p, basic_print, A
	mov	$t5, ",\000"
	call	basic_print_str_p, basic_print_str, $t5
	call	basic_print_str_p, basic_print_str, B$
	mov	$t6, ",\000"
	call	basic_print_str_p, basic_print_str, $t6
	call	basic_print_p, basic_print, C
	mov	$t7, ",\000"
	call	basic_print_str_p, basic_print_str, $t7
	call	basic_print_str_p, basic_print_str, D$
	mov	$t8, ",\000"
	call	basic_print_str_p, basic_print_str, $t8
	call	basic_print_p, basic_print, E
	call	basic_print_str_p, basic_print_str, "\n\000"
L6:
	call	basic_set_line_p, basic_set_line, 6.00000000000000000000000000000000000000000000000000000e+01
	call	basic_data_fini_p, basic_data_fini
	ret	0
	call	basic_data_fini_p, basic_data_fini
	ret	0
	endfunc
	endmodule
