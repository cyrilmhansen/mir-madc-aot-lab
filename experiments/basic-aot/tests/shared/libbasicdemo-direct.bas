FUNCTION SQUARE(X)
SQUARE = X * X
END FUNCTION

FUNCTION ADD(A,B)
ADD = A + B
END FUNCTION

FUNCTION STRLEN(S$)
STRLEN = LEN(S$)
END FUNCTION

SUB REPORT(X)
PRINT X
END SUB

FUNCTION LITERAL$(TEXT$)
LITERAL$ = "literal"
END FUNCTION

FUNCTION ECHO$(TEXT$)
ECHO$ = TEXT$
END FUNCTION

FUNCTION LOCAL$(TEXT$)
TEMP$ = UPPER$(TEXT$)
LOCAL$ = TEMP$
END FUNCTION

FUNCTION CONCAT$(A$,B$)
CONCAT$ = A$ + B$
END FUNCTION

FUNCTION UPPERTEST$(TEXT$)
UPPERTEST$ = UPPER$(TEXT$)
END FUNCTION

FUNCTION EMPTY$(TEXT$)
EMPTY$ = ""
END FUNCTION

DEF FNBORROWED$(TEXT$)=TEXT$

