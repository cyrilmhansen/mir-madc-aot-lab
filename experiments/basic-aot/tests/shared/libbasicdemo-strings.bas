FUNCTION LITERAL$(TEXT$)
LITERAL$ = "literal"
END FUNCTION

FUNCTION ECHO$(TEXT$)
ECHO$ = TEXT$
END FUNCTION

FUNCTION LOCAL$(TEXT$)
TEMP$ = UPPER$(TEXT$)
LOCAL$ = TEMP$
END FUNCTION

FUNCTION CONCAT$(A$,B$)
CONCAT$ = A$ + B$
END FUNCTION

FUNCTION UPPERTEST$(TEXT$)
UPPERTEST$ = UPPER$(TEXT$)
END FUNCTION

FUNCTION EMPTY$(TEXT$)
EMPTY$ = ""
END FUNCTION

DEF FNBORROWED$(TEXT$)=TEXT$

10 PRINT LITERAL$("x")
20 PRINT ECHO$("echo")
30 PRINT LOCAL$("local")
40 PRINT CONCAT$("con","cat")
50 PRINT UPPERTEST$("bonjour")
60 PRINT "[" + EMPTY$("x") + "]"
70 PRINT FNBORROWED$("borrowed")
80 END
