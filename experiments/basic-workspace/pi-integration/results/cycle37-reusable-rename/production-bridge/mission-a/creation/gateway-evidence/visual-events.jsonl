{"event_id":"cycle19-commit-6-tx_45e543de88ac4d569f462174495a9f54","event_type":"commit","revision":5,"snapshot":"FUNCTION BOUNDED_SCORE(X)\n  BOUNDED_SCORE = X\n  IF (X < 0) THEN\n    BOUNDED_SCORE = 0\n  END IF\n  IF (X > 100) THEN\n    BOUNDED_SCORE = 100\n  END IF\n  BOUNDED_SCORE = BOUNDED_SCORE\nEND FUNCTION\nFUNCTION IS_PASSING(X)\n  IS_PASSING = 0\n  IF (BOUNDED_SCORE(X) >= 60) THEN\n    IS_PASSING = 1\n  END IF\n  IS_PASSING = IS_PASSING\nEND FUNCTION\nFUNCTION IS_EXCELLENT(X)\n  IS_EXCELLENT = 0\n  IF (BOUNDED_SCORE(X) >= 90) THEN\n    IS_EXCELLENT = 1\n  END IF\n  IS_EXCELLENT = IS_EXCELLENT\nEND FUNCTION\nFUNCTION HIGH_PRIORITY(X)\n  HIGH_PRIORITY = 0\n  IF (IS_EXCELLENT(X) >= 1) THEN\n    HIGH_PRIORITY = 1\n  END IF\n  HIGH_PRIORITY = HIGH_PRIORITY\nEND FUNCTION\n","session_id":"cycle35.score-evaluation.v1-step-04","mission_id":"Creation sequence · 4/4 · HIGH_PRIORITY","provenance":"Workspace atomic transaction · genuine Pi commit request","source_event_ref":"pi-1794327519443-18","title":"HIGH_PRIORITY committed","description":"Committed at revision 5; dependencies: is_excellent.function.","focus":{"handles":["high_priority.function","is_excellent.function"],"mapping":"exact_semantic_span","spans":{"function_lines":[25,26,27,28,29,30,31],"call_lines":[27]}},"dependencies":[{"caller":"HIGH_PRIORITY","callee":"IS_EXCELLENT"},{"caller":"IS_EXCELLENT","callee":"BOUNDED_SCORE"},{"caller":"IS_PASSING","callee":"BOUNDED_SCORE"}],"outcome":{"committed":true,"transaction_id":"tx_45e543de88ac4d569f462174495a9f54","bound_callees":["is_excellent.function"]},"presentation_sequence":31}
