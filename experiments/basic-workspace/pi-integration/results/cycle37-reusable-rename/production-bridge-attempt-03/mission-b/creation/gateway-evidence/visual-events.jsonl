{"event_id":"cycle19-commit-6-tx_2495e974605e40b4b3a70993fbd8158c","event_type":"commit","revision":5,"snapshot":"FUNCTION HAS_CREDIT(X)\n  HAS_CREDIT = 0\n  IF (X >= 0) THEN\n    HAS_CREDIT = 1\n  END IF\n  HAS_CREDIT = HAS_CREDIT\nEND FUNCTION\nFUNCTION IS_MINOR(X)\n  IS_MINOR = 0\n  IF (X < 18) THEN\n    IS_MINOR = 1\n  END IF\n  IS_MINOR = IS_MINOR\nEND FUNCTION\nFUNCTION CAN_APPLY(X)\n  CAN_APPLY = 0\n  IF (HAS_CREDIT(X) >= 1) THEN\n    CAN_APPLY = 1\n  END IF\n  IF (IS_MINOR(X) >= 1) THEN\n    CAN_APPLY = 0\n  END IF\n  CAN_APPLY = CAN_APPLY\nEND FUNCTION\nFUNCTION APPROVAL_FLAG(X)\n  APPROVAL_FLAG = 0\n  IF (CAN_APPLY(X) >= 1) THEN\n    APPROVAL_FLAG = 1\n  END IF\n  APPROVAL_FLAG = APPROVAL_FLAG\nEND FUNCTION\n","session_id":"cycle35.eligibility-evaluation.v1-step-04","mission_id":"Creation sequence · 4/4 · APPROVAL_FLAG","provenance":"Workspace atomic transaction · genuine Pi commit request","source_event_ref":"pi-1794327772699-18","title":"APPROVAL_FLAG committed","description":"Committed at revision 5; dependencies: can_apply.function.","focus":{"handles":["approval_flag.function","can_apply.function"],"mapping":"exact_semantic_span","spans":{"function_lines":[25,26,27,28,29,30,31],"call_lines":[27]}},"dependencies":[{"caller":"APPROVAL_FLAG","callee":"CAN_APPLY"},{"caller":"CAN_APPLY","callee":"HAS_CREDIT"},{"caller":"CAN_APPLY","callee":"IS_MINOR"}],"outcome":{"committed":true,"transaction_id":"tx_2495e974605e40b4b3a70993fbd8158c","bound_callees":["can_apply.function"]},"presentation_sequence":30}
