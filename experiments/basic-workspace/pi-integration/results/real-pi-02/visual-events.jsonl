{"event_id":"pi-commit-tx_c1ab51b0f2104149a6f2638735257b1c","frame_id":"pi-commit-tx_c1ab51b0f2104149a6f2638735257b1c","event_type":"commit","revision":5,"snapshot":"FUNCTION AGE_BY_ID(WANTED)\n  DIM PERSON_ID(2)\n  DIM PERSON_AGE(2)\n  PERSON_ID(0) = 101\n  PERSON_ID(1) = 205\n  PERSON_ID(2) = 900\n  PERSON_AGE(0) = 25\n  PERSON_AGE(1) = 55\n  PERSON_AGE(2) = 53\n  AGE_BY_ID = -1\n  FOR I = 0 TO 2\n    IF (PERSON_ID(I) = WANTED) THEN\n      AGE_BY_ID = PERSON_AGE(I)\n    END IF\n  NEXT I\n  AGE_BY_ID = AGE_BY_ID\nEND FUNCTION\nFUNCTION IS_SENIOR(ID)\n  IS_SENIOR = 0\n  IF (AGE_BY_ID(ID) >= 50) THEN\n    IS_SENIOR = 1\n  END IF\n  IS_SENIOR = IS_SENIOR\nEND FUNCTION\nFUNCTION IS_ADULT(ID)\n  IF (AGE_BY_ID(ID) >= 18) THEN\n    IS_ADULT = 1\n  ELSE\n    IS_ADULT = 0\n  END IF\n  IS_ADULT = IS_ADULT\nEND FUNCTION\n","session_id":"pi-cycle16b","mission_id":"IS_ADULT · Pi mission","provenance":"Workspace atomic commit · correlated with Pi tool call","source_event_ref":"pi-1794133494829-9","title":"IS_ADULT committed","description":"New function committed at revision 5 with a bound call to AGE_BY_ID.","mission_status":"Agent commit revision 5 · host validation pending","focus":{"handles":["is_adult.function","age_by_id.function"],"mapping":"exact_semantic_span","spans":{"function_lines":[25,26,27,28,29,30,31,32],"call_lines":[26]}},"dependencies":[{"caller":"AGE_BY_ID","callee":"PERSON_ID[] · PERSON_AGE[]"},{"caller":"IS_SENIOR","callee":"AGE_BY_ID"},{"caller":"IS_ADULT","callee":"AGE_BY_ID"}],"outcome":{"committed":true,"transaction_id":"tx_c1ab51b0f2104149a6f2638735257b1c","bound_callee":"AGE_BY_ID"},"presentation_sequence":4}
