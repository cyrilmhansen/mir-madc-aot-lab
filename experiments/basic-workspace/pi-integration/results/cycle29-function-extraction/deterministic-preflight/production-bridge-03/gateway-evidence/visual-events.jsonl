{"event_id":"cycle29-commit-tx_a10bee0605c34e3a9c3dd2afe5fd2d11","event_type":"commit","revision":13,"snapshot":"FUNCTION NORMALIZE_SCORE(X)\n  IF (X < 0) THEN\n    NORMALIZE_SCORE = 0\n  ELSE\n    NORMALIZE_SCORE = X\n  END IF\n  IF (X > 50) THEN\n    NORMALIZE_SCORE = 50\n  END IF\n  NORMALIZE_SCORE = NORMALIZE_SCORE\nEND FUNCTION\nFUNCTION IS_PASSING(X)\n  IF (NORMALIZE_SCORE(X) >= 45) THEN\n    IS_PASSING = 1\n  ELSE\n    IS_PASSING = 0\n  END IF\n  IS_PASSING = IS_PASSING\nEND FUNCTION\nFUNCTION SCORE_CLASS(X)\n  SCORE_CLASS = BASE_SCORE_CLASS(X)\n  IF (IS_PASSING(X) = 1) THEN\n    SCORE_CLASS = 2\n  END IF\n  IF (IS_AT_CAP(X) = 1) THEN\n    SCORE_CLASS = 3\n  END IF\n  SCORE_CLASS = SCORE_CLASS\nEND FUNCTION\nFUNCTION IS_AT_CAP(X)\n  IF (NORMALIZE_SCORE(X) = 50) THEN\n    IS_AT_CAP = 1\n  ELSE\n    IS_AT_CAP = 0\n  END IF\n  IS_AT_CAP = IS_AT_CAP\nEND FUNCTION\nFUNCTION BASE_SCORE_CLASS(X)\n  IF (NORMALIZE_SCORE(X) < 20) THEN\n    BASE_SCORE_CLASS = 0\n  ELSE\n    BASE_SCORE_CLASS = 1\n  END IF\n  BASE_SCORE_CLASS = BASE_SCORE_CLASS\nEND FUNCTION\n","session_id":"cycle29-mission-b-replace-block","mission_id":"Mission B · replace SCORE_CLASS block","provenance":"Workspace atomic semantic transaction · genuine Pi commit request","title":"SCORE_CLASS block extracted","description":"The first IF was replaced by BASE_SCORE_CLASS(X). Its two branch assignments retired; the replacement has a fresh statement identity.","focus":{"handles":["score_class.function","base_score_class.function","score_class.statement.extracted-base-call","score_class.statement.0","score_class.statement.1"],"mapping":"verified_function_boundary"},"dependencies":[{"caller":"BASE_SCORE_CLASS","callee":"NORMALIZE_SCORE"},{"caller":"IS_AT_CAP","callee":"NORMALIZE_SCORE"},{"caller":"IS_PASSING","callee":"NORMALIZE_SCORE"},{"caller":"SCORE_CLASS","callee":"BASE_SCORE_CLASS"},{"caller":"SCORE_CLASS","callee":"IS_AT_CAP"},{"caller":"SCORE_CLASS","callee":"IS_PASSING"}],"outcome":{"committed":true,"w