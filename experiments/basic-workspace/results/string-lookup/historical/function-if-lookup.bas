FUNCTION PERSON_NAME$(WANTED)
  DIM PERSON_ID(2)
  DIM PERSON_NAMES$(2)
  PERSON_ID(0) = 101
  PERSON_ID(1) = 205
  PERSON_ID(2) = 900
  PERSON_NAMES$(0) = "Alice"
  PERSON_NAMES$(1) = "Bob"
  PERSON_NAMES$(2) = "Chloé"
  PERSON_NAME$ = ""
  FOR I = 0 TO 2
    IF PERSON_ID(I) = WANTED THEN
      PERSON_NAME$ = PERSON_NAMES$(I)
    END IF
  NEXT I
END FUNCTION
PRINT PERSON_NAME$(205)
