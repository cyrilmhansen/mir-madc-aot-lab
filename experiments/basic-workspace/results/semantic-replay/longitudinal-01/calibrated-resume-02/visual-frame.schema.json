{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basic-workspace.visual-frames",
  "title": "BASIC Workspace visual frame v2",
  "type": "object",
  "required": [
    "schema",
    "version",
    "campaigns"
  ],
  "properties": {
    "schema": {
      "const": "basic-workspace.visual-frames"
    },
    "version": {
      "const": 2
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "provenance",
                "revision",
                "event_type",
                "state",
                "code",
                "highlights"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source_event_ref": {},
                "session_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mission_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "provenance": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "event_revision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "event_type": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "highlights": {
                  "type": "object"
                },
                "preview": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "outcome": {
                  "type": [
                    "object",
                    "string",
                    "null"
                  ]
                },
                "validation": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "dependencies": {
                  "type": "array"
                },
                "observation": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "observation_freshness": {
                  "enum": [
                    "current",
                    "historical",
                    "unknown"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
