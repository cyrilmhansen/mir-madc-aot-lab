{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BASIC Workspace presentation event",
  "$id": "basic-workspace.presentation-event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "provenance"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "frame_id": {
      "type": "string"
    },
    "presentation_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "initial",
        "selection",
        "preview",
        "rejection",
        "commit",
        "validation",
        "checkpoint",
        "context_reset",
        "reconstruction",
        "observation"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provenance": {
      "type": "string"
    },
    "source_event_ref": {},
    "title": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "focus": {
      "type": "object",
      "properties": {
        "handles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_target": {
          "type": "string"
        },
        "mapping": {
          "enum": [
            "exact_semantic_span",
            "unknown",
            "verified_function_boundary",
            "verified_unique_line_difference"
          ]
        },
        "spans": {
          "type": "object",
          "properties": {
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start_line",
                  "start_column",
                  "end_line",
                  "end_column"
                ],
                "properties": {
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "start_column": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_column": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "role": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "function_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "statement_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "expression_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "parameter_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "declaration_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "call_lines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "string",
      "description": "Rendered display snapshot captured from the authoritative Workspace at commit; never re-imported."
    },
    "preview": {
      "type": [
        "object",
        "null"
      ]
    },
    "outcome": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "validation": {
      "type": [
        "object",
        "null"
      ]
    },
    "observation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "function": {
          "type": "string"
        },
        "arguments": {},
        "engine_results": {
          "type": "object"
        },
        "agreement": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
