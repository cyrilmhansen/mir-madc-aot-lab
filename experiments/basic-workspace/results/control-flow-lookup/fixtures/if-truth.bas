FUNCTION TRUTH(X)
  TRUTH = 0
  IF X THEN
    TRUTH = 1
  END IF
END FUNCTION
FUNCTION TRUTH_COMPARE(X)
  TRUTH_COMPARE = 0
  IF X <> 0 THEN
    TRUTH_COMPARE = 1
  END IF
END FUNCTION
PRINT TRUTH(0)
PRINT TRUTH(1)
PRINT TRUTH(-1)
PRINT TRUTH_COMPARE(0)
PRINT TRUTH_COMPARE(1)
PRINT TRUTH_COMPARE(-1)
