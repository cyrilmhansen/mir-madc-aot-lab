                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "const": "renumber_line"
                      },
                      "old_line": {
                        "type": "integer"
                      },
                      "new_line": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "operation",
                      "old_line",
                      "new_line"
