                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "const": "move_function"
                      },
                      "symbol_id": {
                        "type": "string"
                      },
                      "before_symbol_id": {
                        "type": [
                          "string",
