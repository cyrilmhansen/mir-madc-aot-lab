    {
      "type": "function",
      "function": {
        "name": "workspace_preview",
        "description": "Validate a semantic transaction on a private snapshot; preview does not reserve a revision. Before renumber_line, discover the exact line with workspace_symbols(kind=line_label, exact_name=old_line, unique=true) or workspace_structure.",
        "parameters": {
          "type": "object",
          "properties": {
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "operations": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "const": "rename_symbol"
                      },
                      "symbol_id": {
                        "type": "string"
                      },
                      "new_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "operation",
                      "symbol_id",
                      "new_name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "const": "renumber_line"
                      },
                      "old_line": {
                        "type": "integer"
                      },
                      "new_line": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "operation",
                      "old_line",
                      "new_line"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "const": "move_function"
                      },
                      "symbol_id": {
                        "type": "string"
                      },
                      "before_symbol_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "operation",
                      "symbol_id"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "include_diff": {
              "type": "boolean"
            }
          },
          "required": [
            "expected_revision",
            "operations"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
