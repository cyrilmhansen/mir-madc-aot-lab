# Locally fetched third-party sources and archives; scripts verify and fetch them.
/vendor/
/downloads/*
!/downloads/SHA256SUMS
!/downloads/decNumber-MD5SUM
/results/linux-x86_64/vendor/

# Rebuildable toolchain outputs. Keep reports, raw CSV/JSON, and diagnostic logs.
/results/artifacts/
/results/macos-arm64/artifacts/
/results/linux-aarch64-qemu/artifacts/
/results/linux-x86_64/artifacts/**
!/results/linux-x86_64/artifacts/
!/results/linux-x86_64/artifacts/multimodule.o
!/results/linux-x86_64/artifacts/mpdecimal-madc/
!/results/linux-x86_64/artifacts/mpdecimal-madc/mpalloc.o

# General build products and local editor/cache files.
*.core
core
core.*
*.dSYM/
__pycache__/
*.py[cod]
.DS_Store
.directory
*.swp
*.swo
