reduce_mod: module
reduce_case: func i64, i64:x
  local i64:n0, i64:n1, i64:n2, i64:n3, i64:converted, i64:result
  mov n0, 7
  mul n1, n0, 9
  add n2, n1, 13
  mov n3, x
  ext8 converted, x
  bge yes, converted, 0
  mov result, 0
  jmp done
yes:
  mov result, 1
done:
  ret result
  endfunc
  endmodule
